{
  "name": "kova-streak-api",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KOVA",
      "id": "5e52796995924648888ab8412642c103"
    }
  ],
  "triggers": {
    // 00:00 UTC = 18:00 в Денвере летом (MDT), 17:00 зимой (MST):
    // время выбрано Pasha (2026-08-26), после конца летнего времени
    // в ноябре сдвинуть на "0 1 * * *", если снова захочет ровно 18:00
    "crons": ["0 0 * * *"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1539370154792853604",
    // через запятую, кто видит вкладку Admin
    "ADMIN_DISCORD_IDS": "614861553790877709",
    "SITE_URL": "https://rauder999.github.io/kova-streak/",
    // пускаем только участников этого сервера
    "GUILD_ID": "1324116611849916446",
    // день группы считается по этой таймзоне (машина Rauder, Mountain Time)
    "TZ_NAME": "America/Denver"
  }
}
