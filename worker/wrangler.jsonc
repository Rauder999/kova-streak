{
  "name": "kova-streak-api",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KOVA",
      "id": "5e52796995924648888ab8412642c103"
    }
  ],
  "triggers": {
    // 00:00 UTC = 18:00 in Denver in summer (MDT), 17:00 in winter (MST):
    // time chosen by Pasha (2026-08-26), after DST ends in November
    // shift to "0 1 * * *" if he wants exactly 18:00 again
    "crons": ["0 0 * * *"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1539370154792853604",
    // comma-separated, who can see the Admin tab
    "ADMIN_DISCORD_IDS": "614861553790877709",
    "SITE_URL": "https://rauder999.github.io/kova-streak/",
    // only members of this server are let in
    "GUILD_ID": "1324116611849916446",
    // the group day is computed in this timezone (Rauder's machine, Mountain Time)
    "TZ_NAME": "America/Denver"
  }
}
